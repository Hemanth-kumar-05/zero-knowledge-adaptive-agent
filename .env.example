# API Configuration
API_VERSION=1.0.0
API_TITLE=Canonical RAG System
API_PHASE=Phase I - Baseline RAG
DEBUG=false

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=canonical_rag_db

# Google Gemini API
GOOGLE_API_KEY=your_gemini_api_key_here

# Groq API
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# CORS Configuration
CORS_ORIGINS=["*"]

# Google OAuth
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# JWT Configuration
JWT_SECRET_KEY=your_secure_random_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Preference Extraction Settings
PREFERENCE_EXTRACTION_ENABLED=true
PREFERENCE_MIN_CONFIDENCE=0.70
PREFERENCE_MAX_PER_USER=50
PREFERENCE_DAILY_LIMIT=20

# Application
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
